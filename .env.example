# Required: browser origin only, with no path or trailing slash.
# Physical phones need trusted HTTPS. Use your verified host's HTTPS origin.
BREADCAST_PUBLIC_URL=

# Empty for root hosting; /app for a proxy that preserves that path.
BREADCAST_PUBLIC_PATH_PREFIX=

# Host file mounted read-only as /run/secrets/operator_token.
# Compose always uses operator token authentication.
BREADCAST_OPERATOR_TOKEN_SOURCE=.runtime/operator-token

# Leave empty to use the host from BREADCAST_PUBLIC_URL for WebRTC.
# Override with comma-separated reachable IP addresses or DNS names if needed.
BREADCAST_ICE_HOSTS=

# Set HTTP_BIND=127.0.0.1 when using a reverse proxy on this Docker host.
# With direct TLS, bind to the interface reachable by phones.
BREADCAST_HTTP_BIND=0.0.0.0
BREADCAST_HTTP_PORT=8080
BREADCAST_PORT=8080
BREADCAST_WEBRTC_PORT=8189
BREADCAST_DELAY=3
# Commentary voice: off keeps commentary as captions only; on calls ElevenLabs.
BREADCAST_SPEECH=off
# Live camera switch transition: dissolve, wipe, or cut. Duration in milliseconds (max 3 s).
BREADCAST_TRANSITION=dissolve
BREADCAST_TRANSITION_MS=600
BREADCAST_RESERVATION_SECONDS=60
BREADCAST_RECONNECT_SECONDS=20

# Leave empty to use the assigned workshop stack. Explicit JSON overrides it.
BREADCAST_FOUNDATION_CONFIG=
# Optional ICE-server JSON file inside the container. Leave empty for direct ICE.
# A TURN route needs a verified service and a separately mounted configuration.
BREADCAST_ICE_SERVERS=
# Direct TLS only: put trusted certificate/key in .runtime/tls, then set:
# BREADCAST_TLS_CERT=/run/breadcast/tls/cert.pem
# BREADCAST_TLS_KEY=/run/breadcast/tls/key.pem
# Leave both empty when a trusted reverse proxy supplies HTTPS.
BREADCAST_TLS_CERT=
BREADCAST_TLS_KEY=

# One repo video works by default. Edit this JSON to select local files or S3 URIs.
# Compose mounts the chosen host file read-only at the runtime configuration path.
BREADCAST_SERVER_VIDEOS_CONFIG_SOURCE=./config/server-videos.json
# Optional S3 settings. Existing VM role credentials are used when keys are absent.
BREADCAST_S3_ENDPOINT_URL=
# Use false only for the assigned S3 endpoint with its VM self-signed chain.
BREADCAST_S3_VERIFY=true
# Read the VM's one *.config file inside Docker. Values are never executed.
# On a host without /config, point this at a folder with your assigned file,
# or an empty folder when supplying all values through .env.
BREADCAST_TEAM_CONFIG_SOURCE=/config

# Workshop VAST/VSS access. Set these from the team's assigned VM configuration.
# Leave empty to play video without archive analysis. Keep .env out of Git.
INGRESS_URL=
USERNAME=
PASSWORD=
S3_CHUNKS_BUCKET=
S3_SEGMENTS_BUCKET=
S3_ENDPOINT=
ACCESS_KEY=
SECRET_KEY=

# Live video-window analysis. Use the assigned endpoints; no example hosts.
# auto enables the supplied stack when its GPU/LLM values are present; 0 disables it.
BREADCAST_STACK_ENABLED=auto
# Start video releases the crew by default. human requires Release control.
BREADCAST_CREW_MODE=automatic
COSMOS3_REASON_URL=
COSMOS3_REASON_MODEL=
YOLO_URL=
COSMOS_EMBED1_URL=
COSMOS_EMBED1_MODEL=
GPU_BEARER_TOKEN=

# W&B application roles on supplied CoreWeave inference.
# Empty IDs select supported defaults from the actual returned account catalog.
# Explicit IDs override defaults; segmentor needs image input and tool output.
WANDB_API_KEY=
WANDB_TEAM=
WANDB_PROJECT=
BREADCAST_WANDB_BASE_URL=https://api.inference.wandb.ai/v1
BREADCAST_DIRECTOR_MODEL=
BREADCAST_COMMENTATOR_MODEL=
BREADCAST_SEGMENTOR_MODEL=

# NVIDIA speech NIM (Magpie) or a configured OpenAI-compatible speech service.
# URL is the service base before /v1. Canary ASR is not a TTS endpoint.
BREADCAST_TTS_URL=
BREADCAST_TTS_PROTOCOL=auto
BREADCAST_TTS_MODEL=
BREADCAST_TTS_API_KEY=
BREADCAST_TTS_VOICE=
BREADCAST_TTS_LANGUAGE=

# ElevenLabs is selected automatically when this key is present.
# Optional IDs override runtime selection from the account's model/voice lists.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
BREADCAST_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
