# Required: the address used by browsers. HTTP is supported for the demo.
# Set this to http://<EC2-public-IP>:8080, or to your HTTPS origin.
BREADCAST_PUBLIC_URL=

# Leave empty to use the host from BREADCAST_PUBLIC_URL for WebRTC.
# Override with comma-separated reachable IP addresses or DNS names if needed.
BREADCAST_ICE_HOSTS=

# Direct EC2 access. Set HTTP_BIND=127.0.0.1 when using a host reverse proxy.
BREADCAST_HTTP_BIND=0.0.0.0
BREADCAST_HTTP_PORT=8080
BREADCAST_PORT=8080
BREADCAST_WEBRTC_PORT=8189
BREADCAST_DELAY=3
BREADCAST_RESERVATION_SECONDS=60
BREADCAST_RECONNECT_SECONDS=20

# Optional mounted paths inside the container. Blank keeps them disabled.
BREADCAST_FOUNDATION_CONFIG=
BREADCAST_ICE_SERVERS=
BREADCAST_TLS_CERT=
BREADCAST_TLS_KEY=
